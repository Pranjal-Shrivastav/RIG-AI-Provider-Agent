# RIG AI Provider Agent Configuration

# Node Identity & Auth
RIG_NODE_ID=
RIG_PROVIDER_NAME=Provider-Node-01
RIG_BACKEND_URL=http://localhost:8000
RIG_AUTH_TOKEN=your_secure_node_auth_token_here

# Monitoring & Heartbeat Frequencies (seconds)
RIG_MONITORING_INTERVAL=1.0
RIG_HEARTBEAT_INTERVAL=10.0

# Provider Resource Allocation Limits
RIG_MAX_CPU_PERCENT=80.0
RIG_MAX_RAM_PERCENT=80.0
RIG_MAX_GPU_PERCENT=90.0
RIG_MAX_VRAM_PERCENT=90.0
RIG_MAX_GPU_TEMP_CELSIUS=85.0
RIG_ALLOW_WORKLOADS=true

# Logging
RIG_LOG_LEVEL=INFO
RIG_LOG_FILE=logs/provider_agent.log
